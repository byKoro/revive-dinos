{
  "format_version": "1.20.80",
  "minecraft:client_entity": {
    "description": {
      "identifier": "revive_dinos:dodo",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "white": "textures/entity/dodo/dodo_white",
        "brown": "textures/entity/dodo/dodo_brown",
        "gray": "textures/entity/dodo/dodo_gray",
        "black": "textures/entity/dodo/dodo_black",
        "tan": "textures/entity/dodo/dodo_tan",
        "green": "textures/entity/dodo/dodo_green",
        "blue": "textures/entity/dodo/dodo_blue",
        "red": "textures/entity/dodo/dodo_red"
      },
      "geometry": {
        "default": "geometry.dodo"
      },
      "animations": {
        "idle": "animation.dodo.idle",
        "walk": "animation.dodo.walk",
        "walk_elevation": "animation.dodo.walk_elevation",
        "run": "animation.dodo.run",
        "jump": "animation.dodo.jump",
        "fall": "animation.dodo.fall",
        "swimming": "animation.dodo.swimming",
        "step_down": "animation.dodo.step_down",
        "high_fall_landing": "animation.dodo.high_fall_landing",
        "hurt": "animation.dodo.hurt",
        "head_tilt": "animation.dodo.head_tilt",
        "look_at_target": "animation.dodo.look_at_target",
        "blink": "animation.dodo.blink",
        "pupils": "animation.dodo.pupils",
        "pupils_idle": "animation.dodo.pupils_idle",
        "pupils_run": "animation.dodo.pupils_run",
        "pupils_swim": "animation.dodo.pupils_swim",
        "pupils_hurt": "animation.dodo.pupils_hurt",
        "pupils_fall": "animation.dodo.pupils_fall",
        "turn_reaction": "animation.dodo.turn_reaction",
        "move_controller": "controller.animation.dodo.move",
        "idle_extras_controller": "controller.animation.dodo.idle_extras",
        "hurt_controller": "controller.animation.dodo.hurt",
        "look_controller": "controller.animation.dodo.look",
        "pupils_controller": "controller.animation.dodo.pupils"
      },
      "scripts": {
        "initialize": [
          "variable.prev_yaw = 0.0;",
          "variable.raw_delta = 0.0;",
          "variable.delta_yaw = 0.0;",
          "variable.smooth_turn = 0.0;",
          "variable.turn_abs = 0.0;",
          "variable.head_turn = 0.0;"
        ],
        "pre_animation": [
          "v.raw_delta = q.body_y_rotation - v.prev_yaw;",
          "v.delta_yaw = v.raw_delta > 180.0 ? v.raw_delta - 360.0 : (v.raw_delta < -180.0 ? v.raw_delta + 360.0 : v.raw_delta);",
          "v.prev_yaw = q.body_y_rotation;",
          "v.smooth_turn = math.lerp(v.smooth_turn, v.delta_yaw, 0.18);",
          "v.turn_abs = math.abs(v.smooth_turn);",
          "v.head_turn = math.lerp(v.head_turn, v.delta_yaw, 0.35);"
        ],
        "animate": [
          "blink",
          "pupils",
          "turn_reaction",
          "move_controller",
          "idle_extras_controller",
          "hurt_controller",
          "look_controller",
          "pupils_controller"
        ]
      },
      "render_controllers": ["controller.render.dodo"],
      "spawn_egg": {
        "base_color": "#8B7355",
        "overlay_color": "#F5F5DC"
      },
      "particle_effects": {
        "feathers": "revive_dinos:dodo_feathers"
      }
    }
  }
}
